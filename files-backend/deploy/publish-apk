#!/bin/bash
# 把安卓安装包放到 https://tapetape.org/download/ 直接下载（普通下载，支持断点续传），并把 https://tapetape.org/apk 指过去。
# 用法：sudo /opt/tapetape-files/publish-apk <apk 文件> <版本号>
#   例：sudo /opt/tapetape-files/publish-apk /tmp/TapeTape-2.0.9-debug.apk 2.0.9
# 同时生成 TapeTape-<版本>.apk.sha256，供人核对。下载文件按版本号永久缓存，所以同一个版本号不能换内容（换内容先升版本号）。
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "要用 sudo 运行"; exit 1; }
src="${1:-}"; ver="${2:-}"
[ -f "$src" ] || { echo "找不到文件：$src"; exit 1; }
[[ "$ver" =~ ^[0-9]+(\.[0-9]+){1,3}$ ]] || { echo "版本号格式不对：$ver（例：2.0.9）"; exit 1; }
[ "$(head -c 2 "$src")" = "PK" ] || { echo "不是 apk 文件"; exit 1; }
dir=/var/www/tapetape-download
name="TapeTape-$ver.apk"
install -d -m 755 "$dir"
sha=$(sha256sum "$src" | cut -d' ' -f1)
if [ -f "$dir/$name" ] && [ "$(sha256sum "$dir/$name" | cut -d' ' -f1)" != "$sha" ]; then
  echo "服务器上已有内容不同的 $name。下载文件会被浏览器长期缓存，同一个版本号不能换内容，请先升版本号"; exit 1
fi
install -m 644 "$src" "$dir/.$name.tmp" && mv "$dir/.$name.tmp" "$dir/$name"
echo "$sha  $name" > "$dir/.$name.sha256.tmp" && chmod 644 "$dir/.$name.sha256.tmp" && mv "$dir/.$name.sha256.tmp" "$dir/$name.sha256"
/opt/tapetape-files/set-apk "/download/$name"
echo "下载地址：https://tapetape.org/download/$name"
echo "SHA-256：$sha"
